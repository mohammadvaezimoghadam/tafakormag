# ==============================================================================
# 🧠 TAFAKOR UNIFIED CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# ⚙️ 1. GLOBAL SETTINGS & ENVIRONMENT PROFILES
# ------------------------------------------------------------------------------
# Profile Selector:
# - For Local Development: Set DEBUG=True (Uses SQLite, Console Logs for OTP)
# - For Server/Production: Set DEBUG=False (Uses PostgreSQL, External APIs for OTP)
DEBUG=False
SECRET_KEY=change-me-to-a-real-secret-key
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 🗄️ 2. DATABASE CONFIGURATION (SQLite / PostgreSQL)
# ------------------------------------------------------------------------------
# In Local Mode (no DB_HOST set), Django falls back to SQLite (db.sqlite3).
# In Docker/Server Mode, DB_HOST is set to 'db' (PostgreSQL container).
DB_NAME=tafakor
DB_USER=postgres
DB_PASSWORD=admin
# DB_HOST=db  # Uncomment this to use PostgreSQL (Docker environment)
DB_PORT=5432

# ------------------------------------------------------------------------------
# 📱 3. OTP CHANNELS CONFIGURATION
# ------------------------------------------------------------------------------
# System dynamically routes OTP via Bale -> Telegram -> Kavenegar Fallback.
# Empty fields will be automatically ignored by the dispatcher.

# A) Bale Bot Service
BALE_BOT_TOKEN=1007824739:VUuQ-5GHnBbpwsIscElyojKaNCvgKamRWi4
VITE_BALE_OTP_BOT_URL=https://ble.ir/Tafakorbot

# B) Telegram Bot Service
TELEGRAM_BOT_TOKEN=8747859258:AAEaZ0qokRiZdAptomCasSwRjRKRHNPdD68
TELEGRAM_PROXY_URL=
ENABLE_TELEGRAM=true

# C) Kavenegar SMS Gateway
KAVENEGAR_SENDER=1000550555055
KAVENEGAR_API_KEY=652B4B2B6951394F4648376655796F36554B4D694D68494E3674486C4E365530307979557257386D4174673D

# ------------------------------------------------------------------------------
# 🔒 4. SECURITY & INTER-SERVICE COMMUNICATION
# ------------------------------------------------------------------------------
# API Key to authenticate the Bot Runner to the Django backend
BOT_API_KEY=tfk_secure_bot_key_a8d7f526b91c4e8574ad8f9c0b2f5671

# ------------------------------------------------------------------------------
# 🐳 5. DOCKER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=tafakor

# نوع فرانت‌ند فعال:
# - برای فرانت‌ند پایتون یکپارچه (NiceGUI): COMPOSE_PROFILES=python
# - برای فرانت‌ند قدیمی Vue 3: COMPOSE_PROFILES=vue
# در صورت نیاز به پروکسی تلگرام، مقدار ',proxy' را به انتهای آن اضافه کنید (مثال: COMPOSE_PROFILES=python,proxy)
COMPOSE_PROFILES=vue

FRONTEND_PORT=8085
FRONTEND_DEV_PORT=8080
BACKEND_API_URL=http://backend:8000/api

# ------------------------------------------------------------------------------
# 🛰️ 6. TELEGRAM BYPASS RELAY PROXY (For Iranian Servers)
# ------------------------------------------------------------------------------
# Set USE_PROXY_RELAY=true to route Telegram traffic via Google/Cloudflare relay
USE_PROXY_RELAY=true
GAS_URL=https://script.google.com/macros/s/AKfycbybvaXPZJZpGjAwSATlM1XICHLWsgHOIVLHJNeuTU3Y8jtzvEnLqjY24p2eLu0vs1DJ/exec
RELAY_TOKEN=TafakorSecureRelay2026!
#TELEGRAM_API_URL=https://api.telegram.org/bot
# For Docker/Iran server deployment, uncomment the line below to route via local proxy container:
 TELEGRAM_API_URL=http://telegram_proxy:8080/bot

# ------------------------------------------------------------------------------
# 🧠 7. دستیار هوشمند تاپیک (Topic AI Assistant & RAG)
# ------------------------------------------------------------------------------
# کلید API مدل زبانی (دریافت کلید از https://openrouter.ai/keys یا https://platform.openai.com)
AI_API_KEY=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

# --- گزینه پیشنهادی ۱: سرویس OpenRouter (بدون تحریم و با دسترسی به صدها مدل متنوع) ---
# آدرس اندپوینت اوپن‌روتر همیشه باید دقیقا https://openrouter.ai/api/v1 باشد
AI_API_BASE_URL=https://openrouter.ai/api/v1
# مدل‌های پرکاربرد اوپن‌روتر:
#   google/gemma-4-31b-it:free  (مدل رایگان جمای گوگل)
#   nvidia/nemotron-3.5-lightning:free (مدل رایگان و پرسرعت انویدیا)
#   openai/gpt-4o-mini          (بسیار سریع، کم‌هزینه و پاسخ‌دهی دقیق به فارسی)
#   deepseek/deepseek-chat      (فوق‌العاده اقتصادی و هوشمند)
#   google/gemini-2.0-flash-001 (فوق‌العاده پرسرعت و ارزان)
AI_MODEL=google/gemma-4-31b-it:free

# --- گزینه ۲: سرویس رسمی OpenAI (نیاز به آی‌پی خارج/سرور خارجی) ---
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- گزینه ۳: سرویس رسمی DeepSeek ---
# AI_API_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 🌐 8. آدرس پلتفرم وب تفکر و پیش‌نمایش پست‌ها (Web & Post Preview URL)
# ------------------------------------------------------------------------------
# در محیط لوکال: پیش‌فرض پورت 5001
# نکته مهم: کلاینت‌های تلگرام و بله روی گوشی، آدرس‌های فاقد پسوند دامنه (مانند localhost) را
# به عنوان لینک لمس‌کردنی شناسایی نمی‌کنند و در دکمه شیشه‌ای هم خطای BUTTON_URL_INVALID می‌دهند.
# برای تست لوکال لمس‌کردنی روی گوشی یا دسکتاپ می‌توانید از دامنه لوکال معتبر استفاده کنید:
FRONTEND_BASE_URL=http://tafakor.localtest.me:5001
# (دامنه localtest.me مستقیماً به 127.0.0.1 اشاره می‌کند و در کلاینت‌ها ۱۰۰٪ لمس‌کردنی است)
#
# در سرور اصلی (پروداکشن): دامنه واقعی با پروتکل HTTPS
# FRONTEND_BASE_URL=https://tafakor.ir
FRONTEND_BASE_URL=https://tafakormag.ir

# ------------------------------------------------------------------------------
# 🛒 9. وب‌سرویس توسعه‌دهندگان کافه‌بازار (پرداخت درون‌برنامه‌ای و اشتراک)
# ------------------------------------------------------------------------------
# در محیط توسعه و تست لوکال: BAZAAR_SANDBOX=true (خرید با توکن‌های تستی mock_ تایید می‌شود)
# در محیط عملیاتی و واقعی: BAZAAR_SANDBOX=false (حتما باید مقادیر زیر پر شوند)
BAZAAR_SANDBOX=true
BAZAAR_PACKAGE_NAME=com.tafakor.quran
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=
